# ==============================================================================
# THINK MIT Pitchfest Website — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SUPABASE CONNECTION (Required)
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key (Safe for client browsers; restricted by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_)
# Grants full database administrative bypass for atomic team registrations and admin API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. ADMIN ACCESS CONTROL (Required)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized administrator emails.
# Only users signed in via Supabase Auth with these emails are granted access to /admin.
ADMIN_EMAILS=admin@mitmysore.in,organizer@mitmysore.in

# ------------------------------------------------------------------------------
# 3. FILEBASE S3-COMPATIBLE STORAGE (Required for Pitch Deck Direct Uploads)
# ------------------------------------------------------------------------------
# SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_.
# Obtain from Filebase Dashboard -> Access Keys
FILEBASE_ACCESS_KEY=your_filebase_access_key
FILEBASE_SECRET_KEY=your_filebase_secret_key
# Name of the private S3 bucket created in Filebase
FILEBASE_BUCKET=think-mitm
# Filebase S3 API endpoint (default: https://s3.filebase.io or https://s3.filebase.com)
FILEBASE_ENDPOINT=https://s3.filebase.io
# Filebase region (default: auto or us-east-1)
FILEBASE_REGION=auto

# Optional: Shared secret token for admin API routes / webhook access
ADMIN_SECRET=your_random_admin_secret_string

# ------------------------------------------------------------------------------
# 4. SITE METADATA & CANONICAL URL (Optional)
# ------------------------------------------------------------------------------
# Base URL used for sitemap generation, Open Graph tags, and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
